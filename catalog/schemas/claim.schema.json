{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Atlas claim catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "claim", "claim_type", "source_ids", "confidence", "status", "as_of", "falsifiers"],
    "properties": {
      "id": {"type": "string"},
      "claim": {"type": "string", "minLength": 12},
      "claim_type": {"enum": ["fact", "inference", "scenario"]},
      "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "confidence": {"enum": ["low", "medium", "high"]},
      "status": {"enum": ["stable", "evolving", "experimental", "speculative"]},
      "as_of": {"type": "string", "format": "date"},
      "falsifiers": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": false
  }
}
