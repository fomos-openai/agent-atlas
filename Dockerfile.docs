FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG QUARTO_VERSION=1.10.18
ARG QUARTO_SHA256=4bdf5a17df300003beb2f8f0e4dfe568e2ca0ff91318220c8537d2655015c430

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl fonts-noto-cjk fonts-jetbrains-mono poppler-utils python3 \
    && curl -fsSLo /tmp/quarto.deb \
       "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" \
    && echo "${QUARTO_SHA256}  /tmp/quarto.deb" | sha256sum -c - \
    && dpkg -i /tmp/quarto.deb \
    && rm -f /tmp/quarto.deb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENTRYPOINT ["quarto"]
